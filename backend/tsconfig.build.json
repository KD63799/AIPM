{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./dist",
    "removeComments": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "prisma", "**/*.spec.ts"]
}
